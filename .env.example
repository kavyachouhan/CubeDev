# Convex Backend
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Cubie Backend API (browser should use Next.js /api/cubie/proxy; keep this for local Cubie)
NEXT_PUBLIC_CUBIE_BACKEND_URL=http://localhost:8000
CUBIE_BACKEND_URL=http://localhost:8000

# Public site URL used as the Convex JWT issuer (must match CONVEX_JWT_ISSUER)
SITE_URL=http://localhost:3000
CONVEX_JWT_ISSUER=http://localhost:3000
CONVEX_JWT_AUDIENCE=convex
# Optional data-URI JWKS for local Convex that cannot fetch localhost
# CONVEX_AUTH_JWKS=
# Optional PKCS8 ES256 private key; otherwise derived from JWT_SECRET_KEY
# CONVEX_AUTH_PRIVATE_KEY=

# WCA OAuth Credentials
# Get these from: https://www.worldcubeassociation.org/oauth/applications
# Server-side (token exchange)
WCA_CLIENT_ID=your_wca_client_id
WCA_CLIENT_SECRET=your_wca_client_secret
WCA_REDIRECT_URI=http://localhost:3000/auth/wca/callback
# Client-side authorize URL (client id is public by OAuth design)
NEXT_PUBLIC_WCA_CLIENT_ID=your_wca_client_id
NEXT_PUBLIC_WCA_REDIRECT_URI=http://localhost:3000/auth/wca/callback

# JWT Secret Key (also set this on the Convex deployment)
# Generate a secure secret:
# openssl rand -base64 64
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_64_characters
JWT_ALGORITHM=HS256
JWT_ISSUER=cubedev
JWT_AUDIENCE=cubie-backend
JWT_EXPIRATION=1h

# Admin access (comma-separated). Also set ADMIN_EMAIL on the Convex deployment.
ADMIN_EMAIL=you@example.com

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
CONTACT_EMAIL_TO=contact@cubedev.xyz

# Appwrite (journal media)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
NEXT_PUBLIC_APPWRITE_JOURNAL_BUCKET_ID=your_journal_bucket_id

# Web Push (optional until push is enabled)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@cubedev.xyz
