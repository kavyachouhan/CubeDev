# ==================== SERVER CONFIGURATION ====================
# FastAPI Server
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins). Do not use * in production.
CORS_ORIGINS=http://localhost:3000,https://cubedev.xyz,https://www.cubedev.xyz
ENV=development

# ==================== DATABASE CONFIGURATION ====================
# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cubedev

# MongoDB Collections (optional, defaults will be used if not set)
CHAT_SESSIONS_COLLECTION=chat_sessions
CHAT_MESSAGES_COLLECTION=chat_messages
KNOWLEDGE_BASE_COLLECTION=knowledge_base

# ==================== LLM CONFIGURATION ====================
# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Options: gemini-1.5-pro, gemini-1.5-flash, gemini-1.5-flash-8b

# LLM Settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ==================== RAG CONFIGURATION ====================
# MongoDB Atlas Vector Search
VECTOR_SEARCH_INDEX_NAME=vector_index
EMBEDDING_MODEL=models/embedding-001

# RAG Settings
RAG_TOP_K=5
RAG_USE_MMR=true
RAG_MMR_LAMBDA=0.5

# ==================== SEARCH CONFIGURATION ====================
# Tavily Search API (for web search agent)
TAVILY_API_KEY=your_tavily_api_key_here

# ==================== AUTHENTICATION ====================
# Convex Authentication (for legacy support)
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# JWT Settings (PRODUCTION - REQUIRED)
# Generate a secure secret key:
# Method 1: openssl rand -base64 64
# Method 2: python -c "from app.auth.jwt_utils import generate_jwt_secret; print(generate_jwt_secret())"
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_64_characters
JWT_ALGORITHM=HS256

# Development Mode (DANGEROUS - only use for local development)
# When true, bypasses ALL authentication checks
# NEVER set to true in production! Rejected unless ENV=development.
SKIP_AUTH_VALIDATION=false

# ==================== RATE LIMITING ====================
# Rate Limit Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ==================== WCA API CONFIGURATION ====================
# WCA API Endpoints (official and unofficial)
WCA_API_BASE=https://www.worldcubeassociation.org/api/v0
WCA_UNOFFICIAL_API_BASE=https://wcascrap-64e44a2b3e5b.herokuapp.com/api/V1
WCA_REST_API_BASE=https://wca-rest-api.robiningelbrecht.be

# ==================== AGENT CONFIGURATION ====================
# Agent Settings
ENABLE_CUBEDEV_AGENT=true
ENABLE_WCA_AGENT=true
ENABLE_WEB_SEARCH_AGENT=true

# Agent Timeouts (in seconds)
AGENT_TIMEOUT=30
TOOL_TIMEOUT=15

# ==================== MEMORY CONFIGURATION ====================
# Conversation Memory
MEMORY_TYPE=buffer
# Options: buffer, summary, window

MEMORY_MAX_TOKENS=2000
MEMORY_WINDOW_SIZE=10
MEMORY_SUMMARY_THRESHOLD=20

# ==================== LOGGING & MONITORING ====================
# Logging Level
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Enable request logging
LOG_REQUESTS=true

# LangSmith (optional - for LangChain tracing)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cubie-ai
LANGSMITH_TRACING=false

# ==================== FEATURE FLAGS ====================
# Feature toggles
ENABLE_RAG=true
ENABLE_STREAMING=true
ENABLE_FEEDBACK=true
ENABLE_ANALYTICS=true

# ==================== PERFORMANCE ====================
# Connection Pool Settings
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2

# Request Timeout (in seconds)
REQUEST_TIMEOUT=60

# ==================== DEVELOPMENT ====================
# Debug Mode
DEBUG=false

# Reload on code change (uvicorn)
RELOAD=false

# ==================== OPTIONAL SERVICES ====================
# Redis (for advanced caching - optional)
REDIS_URL=

# Sentry (for error tracking - optional)
SENTRY_DSN=

# ==================== NOTES ====================
# 1. Never commit this file with real credentials
# 2. Copy to .env and fill in your actual values
# 3. Keep .env in .gitignore
# 4. For production, use environment variables or secrets management
# 5. Rotate API keys regularly
